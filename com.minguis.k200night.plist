<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd 정의: 평일(월~금) 17:55 KST 에 K200 야간선물 릴레이 시작.
  스크립트가 다음 날 06:05 KST 에 스스로 종료하므로 하루 한 번만 뜬다.

  ⚠ 설치 전 아래 경로 3곳(REPO_PATH)을 실제 clone 경로로 바꾸세요.
  ⚠ RELAY_URL / RELAY_TOKEN 을 실제 Worker 주소·시크릿으로 채우세요
     (KIS 키는 ~/.config/secrets/keys.env 에서 자동으로 읽습니다).

  설치:  cp com.minguis.k200night.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.minguis.k200night.plist
  Mac 시간대가 KST 여야 하고, 밤새 깨어 있어야 합니다(절전 차단 에이전트 필요).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.minguis.k200night</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>REPO_PATH/scripts/k200_night_relay.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>55</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>55</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>55</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>55</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>55</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>REPO_PATH/k200night.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_PATH/k200night.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>RELAY_URL</key>
    <string>https://k200-night.eogks879.workers.dev/</string>
    <key>RELAY_TOKEN</key>
    <string>PUT_RELAY_TOKEN_HERE</string>
  </dict>
</dict>
</plist>
